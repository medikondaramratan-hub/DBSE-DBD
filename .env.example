# ============================================================
# Production environment configuration template
# ============================================================

# Database Configuration
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=exam_prep_db
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_strong_database_password

# Spring Security & JWT Secret Key (Base64-encoded, minimum 32 bytes)
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_new_base64_secret
JWT_EXPIRATION_MS=86400000

# Comma-separated list of deployed frontend origins; no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Cache Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
